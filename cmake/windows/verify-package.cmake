# Run against the staged install tree before creating a Windows release ZIP.
cmake_minimum_required(VERSION 3.16)
foreach(argument PACKAGE_DIR SHERPA_LIB_DIR PLUGIN_NAME)
  if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
    message(FATAL_ERROR "${argument} is required")
  endif()
endforeach()

set(plugin_bin "${PACKAGE_DIR}/${PLUGIN_NAME}/bin/64bit")
foreach(required_dll "${PLUGIN_NAME}.dll" sherpa-onnx-c-api.dll onnxruntime.dll)
  if(NOT EXISTS "${plugin_bin}/${required_dll}")
    message(FATAL_ERROR "Windows package is missing ${plugin_bin}/${required_dll}")
  endif()
endforeach()
file(GLOB runtime_dlls "${SHERPA_LIB_DIR}/*.dll")
if(NOT runtime_dlls)
  message(FATAL_ERROR "No sherpa-onnx runtime DLLs found in ${SHERPA_LIB_DIR}")
endif()
foreach(runtime_dll IN LISTS runtime_dlls)
  get_filename_component(dll_name "${runtime_dll}" NAME)
  if(NOT EXISTS "${plugin_bin}/${dll_name}")
    message(FATAL_ERROR "Windows package is missing ${plugin_bin}/${dll_name}")
  endif()
  file(SHA256 "${runtime_dll}" source_hash)
  file(SHA256 "${plugin_bin}/${dll_name}" package_hash)
  if(NOT source_hash STREQUAL package_hash)
    message(FATAL_ERROR "Windows package has a mismatched runtime DLL: ${dll_name}")
  endif()
endforeach()
if(NOT EXISTS "${PACKAGE_DIR}/${PLUGIN_NAME}/data/locale/en-US.ini")
  message(FATAL_ERROR "Windows package is missing the default locale")
endif()
message(STATUS "Windows package runtime dependencies verified")
